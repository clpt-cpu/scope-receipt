{
  "name": "scope-receipt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Review extra work against its source notes before drafting a PayPal sandbox invoice.",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "start": "node server/index.mjs",
    "start:sandbox": "node --env-file=.env server/index.mjs",
    "start:agent": "node --env-file-if-exists=.env server/index.mjs --agent",
    "train": "node scripts/train.mjs",
    "test": "node --test test/*.test.mjs",
    "test:ui": "playwright test",
    "check:public": "node scripts/prepare-public.mjs --check",
    "prepare:public": "node scripts/prepare-public.mjs",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "ag-grid-community": "36.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5"
  }
}
